# Slack Bot Token
SLACK_BOT_TOKEN=your-slack-bot-token

# Slack App Token
SLACK_APP_TOKEN=your-slack-app-token

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# GPT Model Configuration
GPT_MODEL=gpt-4o
GPT_SYSTEM_DESC="You are an AI assistant integrated into a bot application. Your primary goals are to: - Be helpful, knowledgeable, concise, and clear."

# Image Generation Configuration
GPT_IMAGE_SIZE=1024x1024

# History and Context Expiration Settings
HISTORY_EXPIRES_IN=900
HISTORY_SIZE=3
PDF_CONTEXT_EXPIRES_IN=3600
THREAD_HISTORY_EXPIRES_IN=1800

# Notion Company Wiki search (/wiki)
NOTION_TOKEN=your-notion-integration-token
NOTION_WIKI_DATA_SOURCE_ID=30840c6a-9bad-4534-9b41-3f216c7062da
NOTION_WIKI_DATABASE_ID=7dd88efc-5462-43e9-985c-8b401f23a5ad
WIKI_PUBLIC_BASE_URL=https://wiki.intertrendhub.com
WIKI_INDEX_REFRESH_SECONDS=900
